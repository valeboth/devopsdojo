{
  "name": "devopsdojo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first PWA that takes you from 0 to senior DevOps: micro-lessons, FSRS spaced repetition and interleaving across 10 certification-anchored modules.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:wrangler": "npm run build && wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run content:validate",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply devopsdojo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply devopsdojo-db --remote",
    "content:validate": "node --import tsx/esm scripts/content/validate.ts",
    "content:sync": "node --import tsx/esm scripts/content/sync.ts",
    "content:stats": "node --import tsx/esm scripts/content/stats.ts",
    "content:translate-check": "node --import tsx/esm scripts/content/translate-check.ts",
    "seed:dev": "node --import tsx/esm scripts/seed-dev.ts",
    "icons": "node --import tsx/esm scripts/gen-icons.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "better-auth": "^1.7.5",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.3",
    "marked": "^18.0.14",
    "ts-fsrs": "^5.4.2",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  }
}
